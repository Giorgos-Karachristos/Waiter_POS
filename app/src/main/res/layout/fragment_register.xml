<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp"
    tools:context=".ui.waiter.register.RegisterFragment">

    <TextView
        android:id="@+id/orderIDTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/itemTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/item"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/qtyTextView"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/orderIDTextView" />

    <TextView
        android:id="@+id/qtyTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/qty"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/itemTextView"
        app:layout_constraintEnd_toStartOf="@+id/taxTextView"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/itemTextView" />

    <TextView
        android:id="@+id/taxTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tax"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/qtyTextView"
        app:layout_constraintEnd_toStartOf="@+id/totalPriceTextView"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/qtyTextView" />

    <TextView
        android:id="@+id/totalPriceTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/total_price"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/taxTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@+id/taxTextView" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/subtotalEditTextNumberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/itemTextView" />

    <TextView
        android:id="@+id/subtotalAmountTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/subtotal"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/subtotalEditTextNumberDecimal"
        app:layout_constraintEnd_toStartOf="@+id/subtotalEditTextNumberDecimal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/subtotalEditTextNumberDecimal"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/subtotalEditTextNumberDecimal"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="@string/zero"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/tipEditTextNumberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/subtotalAmountTextView" />

    <TextView
        android:id="@+id/tipTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/tip"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/tipEditTextNumberDecimal"
        app:layout_constraintEnd_toStartOf="@+id/tipEditTextNumberDecimal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tipEditTextNumberDecimal"
        app:layout_constraintVertical_bias="1.0" />

    <EditText
        android:id="@+id/tipEditTextNumberDecimal"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="@string/zero"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/discountEditTextNumberDecimal4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tipTextView" />

    <TextView
        android:id="@+id/discountTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/discount"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/discountEditTextNumberDecimal4"
        app:layout_constraintEnd_toStartOf="@+id/discountEditTextNumberDecimal4"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/discountEditTextNumberDecimal4"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/discountEditTextNumberDecimal4"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="@string/zero"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/totalEditTextNumberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/discountTextView" />

    <TextView
        android:id="@+id/totalTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/total"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/totalEditTextNumberDecimal"
        app:layout_constraintEnd_toStartOf="@+id/totalEditTextNumberDecimal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/totalEditTextNumberDecimal"
        app:layout_constraintVertical_bias="1.0" />

    <EditText
        android:id="@+id/totalEditTextNumberDecimal"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="@string/zero"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/receivedAmountEditTextNumberDecimal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/totalTextView" />

    <TextView
        android:id="@+id/receivedAmountTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center_horizontal|center_vertical"
        android:text="@string/received_amount"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/receivedAmountEditTextNumberDecimal"
        app:layout_constraintEnd_toStartOf="@+id/receivedAmountEditTextNumberDecimal"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/receivedAmountEditTextNumberDecimal"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/receivedAmountEditTextNumberDecimal"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:ems="10"
        android:inputType="numberDecimal"
        android:text="@string/zero"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/changeValueTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/receivedAmountTextView" />

    <TextView
        android:id="@+id/changeTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/change"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/payOrderButton"
        app:layout_constraintEnd_toStartOf="@+id/changeValueTextView"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/changeValueTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/zero"
        android:textAlignment="center"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/cancelOrderButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/changeTextView" />

    <Button
        android:id="@+id/payOrderButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/mantis"
        android:text="@string/pay_order"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cancelOrderButton"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/cancelOrderButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/burnt_sienna"
        android:text="@string/cancel_order"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/payOrderButton" />
</androidx.constraintlayout.widget.ConstraintLayout>